# OpenClaw Secrets — DO NOT commit real values.
# Copy this file, fill in values, and apply manually:
#
#   cp secrets.yaml.example secrets.yaml
#   # edit secrets.yaml with real values
#   kubectl apply -f secrets.yaml
#
# Or create the secret imperatively:
#
#   kubectl create secret generic openclaw-env-secret -n openclaw \
#     --from-literal=ANTHROPIC_API_KEY=sk-ant-xxx \
#     --from-literal=OPENCLAW_GATEWAY_TOKEN=your-gateway-token \
#     --from-literal=SMTP_PASSWORD=your-smtp-password

apiVersion: v1
kind: Secret
metadata:
  name: openclaw-env-secret
  namespace: openclaw
type: Opaque
stringData:
  # Required — Anthropic API key for Claude models
  ANTHROPIC_API_KEY: "sk-ant-REPLACE_ME"

  # Required — Gateway authentication token (generate with: openssl rand -hex 32)
  OPENCLAW_GATEWAY_TOKEN: "REPLACE_ME"

  # Optional — Telegram bot token for Slack/Telegram channel integration
  # TELEGRAM_BOT_TOKEN: ""

  # Optional — SMTP credentials for email outreach
  # SMTP_HOST: "smtp.example.com"
  # SMTP_PORT: "587"
  # SMTP_USER: "marketeer@yourcompany.com"
  # SMTP_PASSWORD: ""

  # Optional — LinkedIn API (for scheduled posting)
  # LINKEDIN_ACCESS_TOKEN: ""

  # Optional — X/Twitter API credentials
  # TWITTER_API_KEY: ""
  # TWITTER_API_SECRET: ""
  # TWITTER_ACCESS_TOKEN: ""
  # TWITTER_ACCESS_SECRET: ""
